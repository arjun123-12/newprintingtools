# ===================================================
# PRINT ECOMMERCE PLATFORM - MONOREPO ENVIRONMENT
# ===================================================

# Platform Environment
NODE_ENV=development
APP_ENV=local
APP_NAME="Print Ecommerce "

# Frontend Applications
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Laravel Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
API_INTERNAL_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=print_ecommerce
DB_USERNAME=root
DB_PASSWORD=

# Redis & Cache
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Storage (Cloudflare R2 / S3 Compatible)
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET=print-ecommerce-artwork
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://artwork.printecommerce.com.au

# Currency & Locale ()
DEFAULT_CURRENCY=AUD
DEFAULT_LOCALE=en-AU
GST_RATE=0.10
